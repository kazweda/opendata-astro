{
  "name": "@kazweda/opendata-astro",
  "version": "0.1.13",
  "type": "module",
  "description": "Open data chart components for Astro, fetching data at build time.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./integration": {
      "types": "./src/integration.ts",
      "default": "./src/integration.ts"
    }
  },
  "peerDependencies": {
    "astro": "^4 || ^5 || ^6 || ^7",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "astro": "^7.2.9",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "react-chartjs-2": "^5.3.1"
  }
}
