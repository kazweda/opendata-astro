{
  "name": "@kazweda/opendata-astro",
  "version": "0.2.1",
  "type": "module",
  "description": "Open data chart components for Astro, fetching data at build time.",
  "license": "MIT",
  "keywords": [
    "astro-component",
    "astro",
    "opendata",
    "e-stat",
    "chart"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./integration": {
      "types": "./src/integration.ts",
      "default": "./src/integration.ts"
    }
  },
  "peerDependencies": {
    "astro": "^4 || ^5 || ^6 || ^7"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "astro": "^7.2.9",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  }
}
