---
import { buildChartSpec, type OpenDataChartProps } from './chart';

type Props = OpenDataChartProps;

const { height = '400px', title } = Astro.props;
const spec = buildChartSpec(Astro.props);
---

<div
  style={`position: relative; height: ${height}; width: 100%`}
  data-opendata-chart={JSON.stringify(spec)}
>
  <canvas role="img" aria-label={title}></canvas>
</div>

<script>
  import { renderCharts, destroyDetachedCharts } from './render';

  renderCharts();
  // With View Transitions (<ClientRouter />), new pages are swapped in
  // without re-running this module: free charts from the old page and
  // render the new page's charts.
  document.addEventListener('astro:after-swap', () => destroyDetachedCharts());
  document.addEventListener('astro:page-load', () => renderCharts());
</script>
